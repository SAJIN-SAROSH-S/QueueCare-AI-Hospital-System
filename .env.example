# ==========================================
# QueueCare AI - Environment Configuration
# ==========================================

# Supabase (PostgreSQL, Auth & Realtime)
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_HOSPITAL_ID=hosp-kochi-general-01

# AI Waiting-Time Prediction Microservice (Optional FastAPI service)
# If unavailable or not running, the application automatically falls back
# to the internal algorithmic queue estimation engine with full confidence indicators.
AI_PREDICTION_SERVICE_URL=http://localhost:8000

# Notification Providers (Optional - SMS / WhatsApp / Email abstractions)
# Credentials remain strictly server-side.
SMS_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
NOTIFICATION_FROM_EMAIL=notifications@queuecare.ai
